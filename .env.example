# --- Host ports for docker-compose (change if 5432/6379 are taken locally) ---
POSTGRES_PORT=5442
REDIS_PORT=6390

# --- Database (must match docker-compose.yml) ---
DATABASE_URL=postgres://hub:hub_dev_password@127.0.0.1:5442/hub

# --- Redis (password must match REDIS_PASSWORD in docker-compose.yml) ---
REDIS_URL=redis://:hub_redis_dev_password@127.0.0.1:6390/0

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-plus-char-random-secret
AUTH_TRUST_HOST=true

# --- Rate limiting ---
PLAYGROUND_RATE_LIMIT=20
PLAYGROUND_RATE_WINDOW_SEC=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SEC=900

# --- First admin (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# --- Public site URL (SEO: metadataBase, OG images, sitemap). Inlined at BUILD time. ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
